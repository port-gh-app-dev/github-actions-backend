#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh" 2>/dev/null || true

# Run pre-commit if installed; otherwise do a lightweight check.
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit run --hook-stage pre-commit
else
  # Basic secret/credential hygiene: refuse committing common secret file names
  if git diff --cached --name-only | grep -E '(^\.env$|\.pem$|credentials\.json$)' >/dev/null 2>&1; then
    echo "Refusing to commit files that may contain secrets or credentials."
    exit 1
  fi
fi
