# Copy to .env for local use. Never commit real secrets or credentials.

# AWS (local Terraform / CLI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=

# Terraform variables
TF_VAR_ec2_name=App Server
TF_VAR_ec2_instance_type=t3.micro
TF_VAR_pem_key_name=
TF_VAR_aws_region=us-east-1

# Port API (optional local integration testing)
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=

# Azure (optional)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
